# Copiez ce fichier en .env et adaptez les valeurs
DATABASE_URL=postgresql+psycopg://arenah:arenah_pwd@localhost:5432/arenah
# Clé secrète des jetons : au moins 32 caractères, à changer en production
SECRET_KEY=remplacez-par-une-longue-cle-secrete-aleatoire-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mots de passe initiaux créés par le script d'import (à changer à la 1re connexion)
ADMIN_PASSWORD=Admin@2026
MOT_DE_PASSE_PROVISOIRE=Arenah@2026
